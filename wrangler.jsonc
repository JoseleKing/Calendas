{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendas",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // La web está en GitHub Pages; aquí vive el contador, en https://calendas.calendas.workers.dev
  // (que redirige el resto de rutas a GitHub Pages), sin URLs de vista previa por versión.
  // La web no se sube aquí; en local la sirve `npm run dev` con --assets public.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendas",
      "database_id": "660519d3-6327-4831-80aa-80701c08fe22",
      "migrations_dir": "migrations"
    }
  ]
}
