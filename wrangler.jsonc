{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendas",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // La web está en GitHub Pages; aquí vive el contador, en https://calendas.calendas.workers.dev
  // (que redirige el resto de rutas a GitHub Pages), sin URLs de vista previa por versión.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Para poder redirigir también las páginas a GitHub Pages. En local sigue sirviendo public/.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendas",
      "database_id": "660519d3-6327-4831-80aa-80701c08fe22",
      "migrations_dir": "migrations"
    }
  ]
}
